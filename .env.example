# Copy to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://stefanmarket:stefanmarket@localhost:5433/stefanmarket?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Auth (placeholders — generate real random secrets, never reuse across environments)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Google OAuth (optional — leave unset to disable "Continue with Google"; both the server
# route and the client button are gated on these being present)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Admin bootstrap (used once by `npm run db:seed` to create the first Admin account —
# not read by the running app itself)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME="Admin"
