# Copy to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://stefanmarket:stefanmarket@localhost:5433/stefanmarket?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Auth (placeholders — generate real random secrets, never reuse across environments)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
